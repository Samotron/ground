  'gm-002', 'file-001', 'CH-125', 'Chainage 125', '1d', 81.9, 384125.0, 397202.0, 9.81, '{"kind":"unknown"}', '{"allowGaps":false,"profileSublayerThickness":0.5}', '2026-09-02 14:00:00', '2026-09-02 14:00:00'
