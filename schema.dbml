  'mat-001', 'file-001', 'MADE_GROUND', 'Made Ground', 'anthropogenic', '{"unitWeight":{"value":19.0,"lower":17.0,"upper":21.0,"unit":"kN/m3"},"permeability":{"value":0.000001,"lower":0.0000001,"upper":0.00001,"unit":"m/s"}}', '[{"id":"mc-01","kind":"mohr-coulomb","drainage":"drained","parameters":{"frictionAngleDeg":{"value":30,"lower":27,"upper":33,"unit":"deg"},"cohesion":{"value":2,"lower":0,"upper":5,"unit":"kPa"},"youngModulus":{"value":12000,"lower":8000,"upper":18000,"unit":"kPa"}}}]', '{"kind":"assessed","method":"engineering interpretation"}', '2026-09-02 14:00:00', '2026-09-02 14:00:00'
  'mat-002', 'file-001', 'LONDON_CLAY', 'London Clay', 'clay', '{"unitWeight":{"value":20.0,"lower":19.0,"upper":21.0,"unit":"kN/m3"},"saturatedUnitWeight":{"value":20.5,"lower":19.5,"upper":21.5,"unit":"kN/m3"}}', '[{"id":"ut-01","kind":"undrained-tresca","drainage":"undrained","parameters":{"undrainedShearStrength":{"value":75,"lower":60,"upper":90,"unit":"kPa","profile":{"interpolation":"linear","points":[{"depth":5,"value":60,"lower":50,"upper":70},{"depth":20,"value":120,"lower":95,"upper":145}]}}}}]', '{"kind":"assessed","method":"design line","references":["interpretation-001"]}', '2026-09-02 14:00:00', '2026-09-02 14:00:00'
}

